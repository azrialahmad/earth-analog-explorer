# Ask AI (server side only). Copy to .env.local and fill in. Never commit real values.
# Any OpenAI-compatible provider: the server calls {LLM_BASE_URL}/chat/completions.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Optional, for a deployed build: where the app sends questions (the URL of api/ask on your host).
# Leave empty to use /api/ask on the same origin (the Vite dev server serves it).
VITE_ASK_URL=
